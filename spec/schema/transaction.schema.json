{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenttxprotocol.org/schema/transaction.schema.json",
  "title": "ATP transaction annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["reversibility"],
  "properties": {
    "reversibility": { "enum": ["ATOMIC_BRANCHABLE", "COMPENSATABLE", "IRREVERSIBLE"] },
    "adapter": { "enum": ["oltp", "lakehouse", "api"] },
    "table": { "type": "string" },
    "blastRadiusTier": { "enum": ["LOW", "MEDIUM", "HIGH"] },
    "dryRunSupported": { "type": "boolean" },
    "dryRunExample": { "type": "object" },
    "moneyColumns": { "type": "array", "items": { "type": "string" } },
    "idempotencyKeyPath": { "type": "string" },
    "reconciliationTool": { "type": "string" },
    "forwardRetries": { "type": "integer", "minimum": 1 },
    "compensation": { "$ref": "#/$defs/compensation" }
  },
  "$defs": {
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["INVOKE_TOOL", "RESTORE_SNAPSHOT", "NONE"] },
        "tool": { "type": "string" },
        "argumentMapping": { "type": "object", "additionalProperties": { "type": "string" } },
        "maxRetries": { "type": "integer", "minimum": 1 },
        "onCompensationFailure": { "const": "ESCALATE_HITL" }
      }
    }
  }
}
